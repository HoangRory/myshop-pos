<UserControl x:Class="MyShop.Client.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:MyShop.Client.ViewModels"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=viewmodels:AuthViewModel}">

    <UserControl.Resources>
        <!-- Style cho các nhãn nhập liệu -->
        <Style TargetType="TextBlock" x:Key="InputLabelStyle">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#6B6F76"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <!-- VSM: Điều khiển biến hình Form -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="FormStates">
                <!-- TRẠNG THÁI ĐĂNG NHẬP -->
                <VisualState x:Name="LoginState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FormTitle" Storyboard.TargetProperty="Text">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Chào mừng quay lại"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ConfirmPasswordGroup" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToSignupPanel" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToLoginPanel" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>

                <!-- TRẠNG THÁI ĐĂNG KÝ -->
                <VisualState x:Name="SignupState">
                    <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FormTitle" Storyboard.TargetProperty="Text">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="Tạo tài khoản mới"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ConfirmPasswordGroup" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToSignupPanel" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}"/>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ToLoginPanel" Storyboard.TargetProperty="Visibility">
                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}"/>
                        </ObjectAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!-- Trái: Background Image -->
        <Grid Grid.Column="0">
            <Image Source="pack://application:,,,/assets/LoginBackground.jpg" Stretch="UniformToFill"/>
            <Border Background="Black" Opacity="0.3"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="LuciferCore" Foreground="White" FontSize="42" FontWeight="Bold"/>
                <TextBlock Text="Zero Allocation Engine" Foreground="White" Opacity="0.7" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Phải: Form Area -->
        <Grid Grid.Column="1" Margin="60,0">
            <StackPanel VerticalAlignment="Center" MaxWidth="380">

                <TextBlock x:Name="FormTitle" Text="Chào mừng quay lại" FontSize="32" FontWeight="Bold" Margin="0,0,0,30" Foreground="#2F6F9F"/>

                <!-- Username -->
                <TextBlock Text="Tên đăng nhập" Style="{StaticResource InputLabelStyle}"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
         Height="36" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- Password -->
                <TextBlock Text="Mật khẩu" Style="{StaticResource InputLabelStyle}"/>
                <PasswordBox x:Name="PassBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <!-- Confirm Password Group (VSM sẽ điều khiển ẩn hiện cái này) -->
                <StackPanel x:Name="ConfirmPasswordGroup" Visibility="Collapsed">
                    <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource InputLabelStyle}"/>
                    <PasswordBox x:Name="ConfirmPassBox" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                </StackPanel>

                <CheckBox Content="Ghi nhớ tài khoản" IsChecked="{Binding RememberMe}" Margin="0,5,0,25"/>

                <!-- Submit Button -->
                <Button Content="XÁC NHẬN" 
        Command="{Binding SubmitCommand}" 
        CommandParameter="{Binding ElementName=PassBox}" 
        Background="#2F6F9F" Foreground="White" Height="42" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Switch Form Mode -->
                <Grid Margin="0,20,0,0">
                    <StackPanel x:Name="ToSignupPanel" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Chưa có tài khoản?" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button Content="Đăng ký ngay" Background="Transparent" BorderThickness="0" Foreground="#2F6F9F" 
                                FontWeight="Medium" Margin="5,0,0,0" Click="ToSignup_Click" Cursor="Hand"/>
                    </StackPanel>

                    <StackPanel x:Name="ToLoginPanel" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Đã có tài khoản?" Foreground="Gray" VerticalAlignment="Center"/>
                        <Button Content="Đăng nhập" Background="Transparent" BorderThickness="0" Foreground="#2F6F9F" 
                                FontWeight="Medium" Margin="5,0,0,0" Click="ToLogin_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Server Config (⚙) -->
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,10,10">
                <Popup IsOpen="{Binding ShowConfig}" Placement="Top" PlacementTarget="{Binding ElementName=ConfigBtn}" StaysOpen="False">
                    <Border Background="White" BorderBrush="#E6E9EC" BorderThickness="1" Padding="15" CornerRadius="8">
                        <StackPanel Width="160">
                            <TextBlock Text="Cấu hình Server" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding ServerIP}" Margin="0,0,0,8" Tag="IP"/>
                            <TextBox Text="{Binding ServerPort}" Tag="Port"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="ConfigBtn" Content="⚙" FontSize="20" Background="Transparent" BorderThickness="0" 
                        Command="{Binding ToggleConfigCommand}" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>