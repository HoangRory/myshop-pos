<UserControl x:Class="MyShop.Client.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MyShop.Client.Helpers"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MyShop.Client.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:OrdersViewModel}"
             mc:Ignorable="d"
             Padding="14">

    <UserControl.Resources>
        <!-- Palette -->
        <Color x:Key="BgColor">#F1F5F9</Color>
        <Color x:Key="CardBg">#FFFFFFFF</Color>
        <Color x:Key="BorderColor">#D9E2EC</Color>
        <Color x:Key="TextMuted">#607080</Color>
        <Color x:Key="Accent">#0E7490</Color>
        <Color x:Key="AccentDark">#0B5E73</Color>
        <Color x:Key="AccentSoft">#E3F2F7</Color>

        <!-- DataGrid specific colors -->
        <Color x:Key="DataGridHoverBg">#F8FAFB</Color>
        <Color x:Key="DataGridSelectedBg">#E8F0F6</Color>
        <Color x:Key="DataGridEditingBorder">#FFE8B6</Color>

        <LinearGradientBrush x:Key="AppBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8FBFD" Offset="0" />
            <GradientStop Color="{StaticResource BgColor}" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDark}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />

        <SolidColorBrush x:Key="DataGridHoverBrush" Color="{StaticResource DataGridHoverBg}" />
        <SolidColorBrush x:Key="DataGridSelectedBrush" Color="{StaticResource DataGridSelectedBg}" />
        <SolidColorBrush x:Key="DataGridEditingBorderBrush" Color="{StaticResource DataGridEditingBorder}" />

        <helpers:OrderItemsToTotalConverter x:Key="OrderItemsToTotalConverter"/>
        <helpers:DetailPanelWidthConverter x:Key="DetailPanelWidthConverter"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="SectionTitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#203040" />
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
        </Style>

        <!-- Outlined danger -->
        <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D9534F" />
            <Setter Property="Foreground" Value="#D9534F" />
        </Style>

        <!-- Outlined cancel button -->
        <Style x:Key="CancelOutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#6B6F76" />
            <Setter Property="Foreground" Value="#6B6F76" />
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="36" />
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="InputComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="InputDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="Language" Value="vi-VN" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>

                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       Background="Transparent"
                                                       BorderThickness="0"
                                                       VerticalContentAlignment="Center"
                                                       Padding="8,0,6,0"
                                                       Foreground="{TemplateBinding Foreground}" />

                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Focusable="False"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <Grid Width="14" Height="14">
                                            <Path Stretch="Fill"
                                                  Fill="#64748B"
                                                  Data="M3,1H4V2H8V1H9V2H10C10.5523,2 11,2.44772 11,3V10C11,10.5523 10.5523,11 10,11H3C2.44772,11 2,10.5523 2,10V3C2,2.44772 2.44772,2 3,2V1ZM3,4V10H10V4H3Z" />
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Margin="0,4,0,0"
                                        Background="White"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <Calendar x:Name="PART_Calendar"
                                              Background="White"
                                              BorderThickness="0" />
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <TextBlock x:Name="PlaceholderText"
                                       Text="dd/MM/yyyy"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="2,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AlternatingRowBackground" Value="#FAFCFE" />
            <Setter Property="RowBackground" Value="White" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF3F7" />
        </Style>

        <!-- DataGrid row style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                        Background="{TemplateBinding Background}">
                            <DataGridCellsPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border"
                                Property="Background"
                                Value="{StaticResource DataGridSelectedBrush}" />
                                <Setter Property="Foreground"
                                Value="#333333" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border"
                                Property="Background"
                                Value="{StaticResource DataGridHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- DataGrid editing cell TextBox style -->
        <Style x:Key="DataGridEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DataGridEditingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- DataGrid editing cell ComboBox style -->
        <Style x:Key="DataGridEditingComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DataGridEditingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Detail, Converter={StaticResource DetailPanelWidthConverter}, ConverterParameter=Left}" />
            <ColumnDefinition Width="{Binding Detail, Converter={StaticResource DetailPanelWidthConverter}, ConverterParameter=Right}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Đơn hàng" FontSize="18" FontWeight="SemiBold" Foreground="#113347" />
                <Button Content="+ Tạo đơn hàng"
                        Command="{Binding CreateOrderCommand}"
                        Style="{StaticResource PrimaryButton}"
                        DockPanel.Dock="Right"
                    MinWidth="0"
                    Padding="10,6"
                        Margin="8,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Left column: Filters + DataGrid + Pager -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Filter toolbar card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="0" Margin="0,0,0,12">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Status -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              Style="{StaticResource InputComboBoxStyle}"
                              VerticalContentAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="0" />
                    <!-- Date Range -->
                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker Grid.Column="1"
                                    SelectedDate="{Binding FromDate}"
                                    Text="{Binding FromDateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Style="{StaticResource InputDatePickerStyle}"
                                    ToolTip="Nhập ngày hoặc chọn từ lịch, định dạng dd/MM/yyyy"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Đến:" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker Grid.Column="3"
                                    SelectedDate="{Binding ToDate}"
                                    Text="{Binding ToDateText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                    Style="{StaticResource InputDatePickerStyle}"
                                    ToolTip="Nhập ngày hoặc chọn từ lịch, định dạng dd/MM/yyyy"
                                    VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Apply Button -->
                        <Button Grid.Column="2"
                            Content="Áp dụng"
                            Command="{Binding SearchCommand}"
                            Height="32"
                            MinWidth="0"
                            Padding="12,6"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>

            <!-- DataGrid card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="OrdersGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Orders}" 
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              AlternationCount="2"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              CanUserResizeRows="False"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderId}" Width="1.2*" />
                            <DataGridTextColumn Header="Ngày" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="1*" />
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding FinalTotal, StringFormat=N0}" Width="1.2*" />
                            <DataGridTemplateColumn Header="Trạng thái" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="4">
                                            <Border Padding="8,3" CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="0">
                                                                <Setter Property="Background" Value="#F59E0B"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Background" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Background" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="11" TextAlignment="Center" />
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pager (row 1) -->
                    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   DockPanel.Dock="Left">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Trang {0} / {1}">
                                    <Binding Path="PageIndex"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <ComboBox Width="84"
                                  Style="{StaticResource InputComboBoxStyle}"
                                  SelectedValue="{Binding PageSize}"
                                  SelectedValuePath="Content">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>
                            </ComboBox>
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Width="36" Margin="8,0,4,0" Style="{StaticResource NeutralButton}" />
                            <TextBox Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged}" Width="52" HorizontalContentAlignment="Center" Style="{StaticResource InputTextBoxStyle}" />
                            <Button Content="▶" Command="{Binding NextPageCommand}" Width="36" Margin="4,0,0,0" Style="{StaticResource NeutralButton}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Right column: Order detail panel -->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Order Info Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Thông tin đơn hàng" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã đơn" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding Detail.OrderId, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" />
                            <TextBlock Text="Ngày tạo" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <DatePicker SelectedDate="{Binding Detail.CreatedAt, Mode=TwoWay}" Style="{StaticResource InputDatePickerStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Trạng thái" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox
                                ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding Detail.StatusText, Mode=TwoWay}"
                                Style="{StaticResource InputComboBoxStyle}"
                                VerticalContentAlignment="Center"
                                />
                            <TextBlock Text="Tổng tiền" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding Detail.FinalTotal, StringFormat=N0, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource InputTextBoxStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Order Items Card -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Sản phẩm" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentSoftBrush}" Padding="6" CornerRadius="8" DockPanel.Dock="Right">
                            <Button Command="{Binding AddProductCommand}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="Thêm sản phẩm"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </DockPanel>
                    <DataGrid x:Name="OrderItemsGrid"
                              ItemsSource="{Binding Detail.OrderItems}"
                              helpers:DataGridFocusBehavior.PendingFocusItem="{Binding PendingNewOrderItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              RowHeaderWidth="0"
                              AlternationCount="2"
                              CanUserResizeRows="False"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              MaxHeight="250"
                              Background="White"
                              CanUserAddRows="False"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sản phẩm" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName}" Padding="8,0" VerticalAlignment="Center" Foreground="#333333" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AvailableProducts}"
                                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="ProductId"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource DataGridEditingComboBoxStyle}"
                                                  Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SL" Width="0.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity}" Padding="8,0" TextAlignment="Center" VerticalAlignment="Center" Foreground="#333333" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DataGridEditingTextBoxStyle}"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Giá" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat=N0}" Padding="8,0" VerticalAlignment="Center" Foreground="#333333" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tổng" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Total, StringFormat=N0}" Padding="8,0" VerticalAlignment="Center" Foreground="#333333" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Xóa" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="28" Height="28"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Xóa sản phẩm"
                                                Background="Transparent"
                                                Foreground="#D9534F"
                                                Cursor="Hand"
                                                Padding="0"
                                                BorderThickness="0">
                                            <TextBlock Text="✕" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Xóa" Command="{Binding DeleteOrderCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DangerOutlineButton}">
                            <Setter Property="Visibility" Value="Visible" />
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Hủy" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" Style="{StaticResource CancelOutlineButton}"/>
                <Button Content="Lưu" Command="{Binding SaveOrderCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
