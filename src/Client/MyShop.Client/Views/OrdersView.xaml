<UserControl x:Class="MyShop.Client.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MyShop.Client.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MyShop.Client.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewmodels:OrdersViewModel}"
             mc:Ignorable="d"
             Padding="14">

    <UserControl.Resources>
        <!-- Palette -->
        <Color x:Key="BgColor">#F6F7F8</Color>
        <Color x:Key="CardBg">#FFFFFFFF</Color>
        <Color x:Key="BorderColor">#E6E9EC</Color>
        <Color x:Key="TextMuted">#6B6F76</Color>
        <Color x:Key="Accent">#2F6F9F</Color>

        <!-- DataGrid specific colors -->
        <Color x:Key="DataGridHoverBg">#F8FAFB</Color>
        <Color x:Key="DataGridSelectedBg">#E8F0F6</Color>
        <Color x:Key="DataGridEditingBg">#FFFBEA</Color>
        <Color x:Key="DataGridEditingBorder">#FFE8B6</Color>

        <SolidColorBrush x:Key="AppBackground" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />

        <SolidColorBrush x:Key="DataGridHoverBrush" Color="{StaticResource DataGridHoverBg}" />
        <SolidColorBrush x:Key="DataGridSelectedBrush" Color="{StaticResource DataGridSelectedBg}" />
        <SolidColorBrush x:Key="DataGridEditingBrush" Color="{StaticResource DataGridEditingBg}" />
        <SolidColorBrush x:Key="DataGridEditingBorderBrush" Color="{StaticResource DataGridEditingBorder}" />

        <helpers:OrderItemsToTotalConverter x:Key="OrderItemsToTotalConverter"/>
        <helpers:DetailPanelWidthConverter x:Key="DetailPanelWidthConverter"/>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Outlined danger -->
        <Style x:Key="DangerOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D9534F" />
            <Setter Property="Foreground" Value="#D9534F" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="88" />
        </Style>

        <!-- Outlined cancel button -->
        <Style x:Key="CancelOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#6B6F76" />
            <Setter Property="Foreground" Value="#6B6F76" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="88" />
        </Style>

        <!-- DataGrid row style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border"
                        Background="{TemplateBinding Background}">
                            <DataGridCellsPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border"
                                Property="Background"
                                Value="{StaticResource DataGridSelectedBrush}" />
                                <Setter Property="Foreground"
                                Value="#333333" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border"
                                Property="Background"
                                Value="{StaticResource DataGridHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid row editing style -->
        <Style x:Key="EditingDataGridRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        </Style>

        <!-- DataGrid header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        </Style>

        <!-- DataGrid editing cell TextBox style -->
        <Style x:Key="DataGridEditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DataGridEditingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- DataGrid editing cell ComboBox style -->
        <Style x:Key="DataGridEditingComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DataGridEditingBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Detail, Converter={StaticResource DetailPanelWidthConverter}, ConverterParameter=Left}" />
            <ColumnDefinition Width="{Binding Detail, Converter={StaticResource DetailPanelWidthConverter}, ConverterParameter=Right}" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <DockPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Đơn hàng" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="  •  Quản lý đơn hàng" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,8,12,0">
                <Button Content="+ Tạo đơn hàng" Command="{Binding CreateOrderCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </DockPanel>

        <!-- Left column: Filters + DataGrid + Pager -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Filter toolbar card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Search -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tìm kiếm" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />
                    </Grid>
                    <!-- Status -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                              Height="30"
                              VerticalContentAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="8,0,0,0" />
                    <!-- Date Range -->
                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Từ:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="28" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Đến:" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource MutedBrush}" />
                        <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="28" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- Apply Button -->
                    <Button Grid.Column="3"
                            Content="Áp dụng"
                            Command="{Binding SearchCommand}"
                            Height="30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource PrimaryButton}" />
                </Grid>
            </Border>

            <!-- DataGrid card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="OrdersGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Orders}" 
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              CanUserResizeRows="False"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderId}" Width="1.2*" />
                            <DataGridTextColumn Header="Ngày" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="1*" />
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding FinalTotal, StringFormat=N0}" Width="1.2*" />
                            <DataGridTemplateColumn Header="Trạng thái" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="4">
                                            <Border Padding="6,2" CornerRadius="2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#6B7F8F"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="0">
                                                                <Setter Property="Background" Value="#FFA500"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="1">
                                                                <Setter Property="Background" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="2">
                                                                <Setter Property="Background" Value="#D9534F"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="11" TextAlignment="Center" />
                                            </Border>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pager (row 1) -->
                    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   DockPanel.Dock="Left">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Trang {0} / {1}">
                                    <Binding Path="PageIndex"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <ComboBox Width="80"
                                  SelectedValue="{Binding PageSize}"
                                  SelectedValuePath="Content">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>
                            </ComboBox>
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Width="36" />
                            <TextBox Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged}" Width="48" HorizontalContentAlignment="Center" />
                            <Button Content="▶" Command="{Binding NextPageCommand}" Width="36" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Right column: Order detail panel -->
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <!-- Order Info Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Thông tin đơn hàng" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã đơn" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <TextBox Text="{Binding Detail.OrderId, Mode=OneWay}" IsReadOnly="True" Height="30" Padding="8,4" />
                            <TextBlock Text="Ngày tạo" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <DatePicker SelectedDate="{Binding Detail.CreatedAt, Mode=TwoWay}" Height="30" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Trạng thái" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                            <ComboBox
                                ItemsSource="{Binding StatusOptions}"
                                SelectedItem="{Binding Detail.StatusText, Mode=TwoWay}"
                                Height="30"
                                VerticalContentAlignment="Center"
                                />
                            <TextBlock Text="Tổng tiền" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                            <TextBox Text="{Binding Detail.FinalTotal, StringFormat=N0, Mode=OneWay}" IsReadOnly="True" Height="30" Padding="8,4" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Order Items Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock Text="Sản phẩm" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="#F8FAFB" Padding="8" CornerRadius="4" DockPanel.Dock="Right">
                            <Button Command="{Binding AddProductCommand}" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Padding="8,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" FontSize="14" Margin="0,0,4,0"/>
                                    <TextBlock Text="Thêm sản phẩm"/>
                                </StackPanel>
                            </Button>
                        </Border>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Detail.OrderItems}"
                              RowStyle="{StaticResource EditingDataGridRowStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              RowHeaderWidth="0"
                              CanUserResizeRows="False"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              MaxHeight="250"
                              Background="White"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sản phẩm" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProductName}" Padding="8,0" VerticalAlignment="Center" Foreground="#333333" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.AvailableProducts}"
                                                  SelectedItem="{Binding SelectedProduct, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="ProductId"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  StaysOpenOnEdit="True"
                                                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                  Style="{StaticResource DataGridEditingComboBoxStyle}"
                                                  Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SL" Width="0.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Quantity}" Padding="8,0" TextAlignment="Center" VerticalAlignment="Center" Foreground="#333333" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DataGridEditingTextBoxStyle}"
                                                 HorizontalContentAlignment="Center"
                                                 Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Giá" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat=N0}" Padding="8,0" VerticalAlignment="Center" Foreground="#333333" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Tổng" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Total, StringFormat=N0}" Padding="8,0" VerticalAlignment="Center" Foreground="#333333" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Xóa" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Width="28" Height="28"
                                                Command="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=DataContext.RemoveItemCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Xóa sản phẩm"
                                                Background="Transparent"
                                                Foreground="#D9534F"
                                                Cursor="Hand"
                                                Padding="0"
                                                BorderThickness="0">
                                            <TextBlock Text="✕" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Total Amount -->
                    <TextBlock Text="{Binding Detail.OrderItems, Converter={StaticResource OrderItemsToTotalConverter}, StringFormat=Tổng: {0:N0}}"
                               FontWeight="Bold"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Xóa" Command="{Binding DeleteOrderCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DangerOutlineButton}">
                            <Setter Property="Visibility" Value="Visible" />
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Hủy" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" Style="{StaticResource CancelOutlineButton}"/>
                <Button Content="Lưu" Command="{Binding SaveOrderCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
