<UserControl x:Class="MyShop.Client.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:MyShop.Client.Helpers"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodels="clr-namespace:MyShop.Client.ViewModels"
             xmlns:controls="clr-namespace:MyShop.Client.Controls;assembly=MyShop.Client"
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductsViewModel}"
             mc:Ignorable="d"
             Padding="14">

    <UserControl.Resources>
        <!-- Palette -->
        <Color x:Key="BgColor">#F6F7F8</Color>
        <Color x:Key="CardBg">#FFFFFFFF</Color>
        <Color x:Key="BorderColor">#E6E9EC</Color>
        <Color x:Key="TextMuted">#6B6F76</Color>
        <Color x:Key="Accent">#2F6F9F</Color>

        <SolidColorBrush x:Key="AppBackground" Color="{StaticResource BgColor}" />
        <SolidColorBrush x:Key="CardBackground" Color="{StaticResource CardBg}" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />

        <!-- Card style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Base button style -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
        </Style>

        <!-- Outlined danger -->
        <Style x:Key="DangerOutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D9534F" />
            <Setter Property="Foreground" Value="#D9534F" />
        </Style>

        <!-- Outlined cancel button -->
        <Style x:Key="CancelOutlineButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#6B6F76" />
            <Setter Property="Foreground" Value="#6B6F76" />
        </Style>

        <!-- Shared input styles -->
        <Style x:Key="BaseInputStyle" TargetType="Control">
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="FilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BaseInputStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource BaseInputStyle}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- DataGrid header style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        </Style>

        <!-- DataGrid row style -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="DGR_Border" Background="{TemplateBinding Background}">
                            <DataGridCellsPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DGR_Border" Property="Background" Value="#F0F6FA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thumbnail cell template (fallback shows Sku) -->
        <DataTemplate x:Key="ThumbnailTemplate">
            <Border Width="56" Height="40" Background="#FFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="2">
                <TextBlock Text="{Binding Sku}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
            </Border>
        </DataTemplate>

        <helpers:StringNullOrEmptyToVisibilityConverter x:Key="StringToVisibility"/>
        <helpers:SafeDecimalConverter x:Key="SafeDecimalConverter"/>
        <helpers:DetailPanelWidthConverter x:Key="DetailPanelWidthConverter"/>        
        <helpers:BoolToSortDirectionConverter x:Key="BoolToSortDirectionConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource AppBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition>
                <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource DetailPanelWidthConverter}" ConverterParameter="Left|980">
                        <Binding Path="EditingProduct" />
                        <Binding ElementName="RootGrid" Path="ActualWidth" />
                    </MultiBinding>
                </ColumnDefinition.Width>
            </ColumnDefinition>
            <ColumnDefinition>
                <ColumnDefinition.Width>
                    <MultiBinding Converter="{StaticResource DetailPanelWidthConverter}" ConverterParameter="Right|980">
                        <Binding Path="EditingProduct" />
                        <Binding ElementName="RootGrid" Path="ActualWidth" />
                    </MultiBinding>
                </ColumnDefinition.Width>
            </ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <DockPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,8,12,0">
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Nhập Excel" Command="{Binding ImportExcelCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="{Binding AddCategoryButtonText}" Command="{Binding ToggleAddCategoryPanelCommand}" Style="{StaticResource CancelOutlineButton}" Margin="0,0,8,0" />
                    <Button Content="{Binding DeleteCategoryButtonText}" Command="{Binding ToggleDeleteCategoryPanelCommand}" Style="{StaticResource DangerOutlineButton}" Margin="0,0,8,0" />
                    <Button Content="Thêm sản phẩm" Command="{Binding AddProductCommand}" Style="{StaticResource PrimaryButton}" />
                </WrapPanel>
                <DockPanel Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsAddCategoryPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox DockPanel.Dock="Left"
                             Width="200"
                             Height="28"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Lưu danh mục"
                            Command="{Binding AddCategoryCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="28"
                            Margin="8,0,0,0" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Visibility="{Binding IsDeleteCategoryPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ComboBox DockPanel.Dock="Left"
                              Width="200"
                              Height="28"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding DeletableCategories}"
                              SelectedItem="{Binding SelectedCategoryToDelete, Mode=TwoWay}"
                              DisplayMemberPath="Name" />
                    <Button Content="Xóa danh mục"
                            Command="{Binding DeleteCategoryCommand}"
                            Style="{StaticResource DangerOutlineButton}"
                            Height="28"
                            Margin="8,0,0,0" />
                </DockPanel>
            </StackPanel>
        </DockPanel>

        <!-- Left column: Filters + DataGrid + Pager -->
        <Grid Grid.Column="0" Grid.Row="1" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Filter toolbar card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Filters grouped by interaction -->
                    <Grid Grid.RowSpan="2">
                        <WrapPanel VerticalAlignment="Top">
                            <Grid Margin="0,0,12,12" MinWidth="180" MaxWidth="260">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Danh mục" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <ComboBox Grid.Row="1"
                                          ItemsSource="{Binding FilterCategories}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          MinWidth="180"
                                          MaxWidth="260"
                                          Style="{StaticResource FilterComboBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,12,12" MinWidth="280" MaxWidth="420">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Sắp xếp" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              MinWidth="130"
                                              MaxWidth="200"
                                              ItemsSource="{Binding SortOptions}"
                                              SelectedItem="{Binding SortBy, Mode=TwoWay}"
                                              Style="{StaticResource FilterComboBoxStyle}" />
                                    <ComboBox Grid.Column="2"
                                              MinWidth="130"
                                              MaxWidth="200"
                                              SelectedValuePath="Content"
                                              SelectedValue="{Binding IsAscending, Converter={StaticResource BoolToSortDirectionConverter}, Mode=TwoWay}"
                                              Style="{StaticResource FilterComboBoxStyle}">
                                        <ComboBoxItem Content="Tăng dần" />
                                        <ComboBoxItem Content="Giảm dần" />
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,0,12,12" MinWidth="220" MaxWidth="360">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Tìm kiếm" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <TextBox Grid.Row="1"
                                         MinWidth="220"
                                         MaxWidth="360"
                                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FilterTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,12,12" MinWidth="220" MaxWidth="320">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Giá" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             MinWidth="100"
                                             MaxWidth="150"
                                             Text="{Binding MinPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SafeDecimalConverter}}"
                                             Style="{StaticResource FilterTextBoxStyle}" />
                                    <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" Margin="6,0" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Grid.Column="2"
                                             MinWidth="100"
                                             MaxWidth="150"
                                             Text="{Binding MaxPrice, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource SafeDecimalConverter}}"
                                             Style="{StaticResource FilterTextBoxStyle}" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,0,12,12" MinWidth="110" MaxWidth="180">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text=" " Margin="0,0,0,4" Opacity="0" />
                                <Button Grid.Row="1"
                                    Content="Áp dụng"
                                    Command="{Binding ApplyFiltersCommand}"
                                    IsEnabled="{Binding IsApplyEnabled}"
                                    Height="30"
                                    MinWidth="110"
                                    Style="{StaticResource PrimaryButton}" />
                            </Grid>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- DataGrid card -->
            <Border Style="{StaticResource CardStyle}" Grid.Row="1" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="ProductsGrid"
                              Grid.Row="0"
                              ItemsSource="{Binding Products}" 
                              SelectedItem="{Binding SelectedProduct, Mode=OneWayToSource}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              CanUserResizeRows="False"
                              GridLinesVisibility="None"
                              SelectionMode="Single"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="56" Height="40" Background="#FFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Image Source="{Binding Thumbnail}" Width="56" Height="40" Stretch="UniformToFill" />
                                                <TextBlock Text="{Binding Sku}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="3*" />
                            <DataGridTextColumn Header="Sku" Binding="{Binding Sku}" Width="1.2*" />
                            <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="1.4*" />
                            <DataGridTextColumn Header="Giá bán" Binding="{Binding SalePrice, StringFormat=N0}" Width="1*" />
                            <DataGridTemplateColumn Header="Tồn" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="Transparent" Padding="4">
                                            <TextBlock Text="{Binding StockCount}" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StockCount}" Value="0">
                                                                <Setter Property="Foreground" Value="#D9534F" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StockCount}" Value="1">
                                                                <Setter Property="Foreground" Value="#E67E22" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Inline toolbar for grid (top-right) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0">
                        <!-- reserved for contextual grid actions -->
                    </StackPanel>

                    <!-- Pager (row 1) -->
                    <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0">
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   DockPanel.Dock="Left">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Trang {0} / {1}">
                                    <Binding Path="PageIndex"/>
                                    <Binding Path="TotalPages"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <ComboBox Width="80"
                                  SelectedValue="{Binding PageSize}"
                                  SelectedValuePath="Content">
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="25"/>
                                <ComboBoxItem Content="50"/>
                                <ComboBoxItem Content="100"/>

                            </ComboBox>
                            <Button Content="◀" Command="{Binding PrevPageCommand}" Width="36" />
                            <TextBox Text="{Binding PageIndex, UpdateSourceTrigger=PropertyChanged}" Width="48" HorizontalContentAlignment="Center" />
                            <Button Content="▶" Command="{Binding NextPageCommand}" Width="36" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>



        <!-- Right column: Product detail panel -->
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EditingProduct}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Scrollable card content -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <!-- Image gallery card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Hình ảnh" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="Upload ảnh" Command="{Binding UploadImageCommand}"
                                        Width="120" Height="30" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                            </DockPanel>
                            <!-- Preview images -->
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PreviewImages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#DDD" BorderThickness="1"
                                                    Margin="5" Padding="5">
                                                <StackPanel>
                                                    <Image Width="120" Height="120"
                                                        Stretch="UniformToFill" Source="{Binding}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Basic info card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thông tin cơ bản" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Tên" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding EditingProduct.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="8,4" />
                                    <TextBlock Text="Sku" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding EditingProduct.Sku, Mode=TwoWay}" Height="30" Padding="8,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Danh mục" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox
                                        ItemsSource="{Binding EditCategories}"
                                        SelectedValue="{Binding EditingProduct.CategoryId, Mode=TwoWay}"
                                        SelectedValuePath="CategoryId"
                                        DisplayMemberPath="Name"
                                        Height="30"
                                        VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Pricing & inventory card -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Giá &amp; tồn kho" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Giá nhập" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding EditingProduct.ImportPrice, Mode=TwoWay, Converter={StaticResource SafeDecimalConverter}}" Height="30" Padding="8,4" />
                                    <TextBlock Text="Giá bán" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
                                    <TextBox Text="{Binding EditingProduct.SalePrice, Mode=TwoWay, Converter={StaticResource SafeDecimalConverter}}" Height="30" Padding="8,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Số lượng" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding EditingProduct.StockCount, Mode=TwoWay, Converter={StaticResource SafeDecimalConverter}}" Height="30" Padding="8,4" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Xóa" Command="{Binding DeleteProductCommand}" Margin="0,0,8,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DangerOutlineButton}">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <!-- Hide delete when creating a new product (Id == 0) -->
                                <DataTrigger Binding="{Binding EditingProduct.ProductId}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Hủy" Command="{Binding ClearFormCommand}" Margin="0,0,8,0" Style="{StaticResource CancelOutlineButton}"/>
                <Button Content="Lưu" Command="{Binding SaveProductCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <Border Grid.Row="2"
                Background="#FFF3F3"
                BorderBrush="#F5C2C7"
                BorderThickness="1"
                Padding="8"
                Margin="0,10,0,0"
                CornerRadius="4"
                Visibility="{Binding ErrorMessage,Converter={StaticResource StringToVisibility} }">
                <TextBlock Text="{Binding ErrorMessage}"
               Foreground="#D9534F"
               TextWrapping="Wrap"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
