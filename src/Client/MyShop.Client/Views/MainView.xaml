<UserControl x:Class="MyShop.Client.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:MyShop.Client.Views"
             xmlns:vm="clr-namespace:MyShop.Client.ViewModels"
             xmlns:local="clr-namespace:MyShop.Client"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Giữ nguyên 150 nhưng Sidebar thực tế là 260 nên cột này nên khớp 260 -->
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />

        <!-- Sidebar: Layout nguyên bản của bạn -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Width="260"
                Background="#2D2D30"
                Panel.ZIndex="2">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header: Giữ nguyên -->
                <DockPanel Grid.Row="0" Margin="12,8,12,8" LastChildFill="True">
                    <TextBlock Text="Menu" Foreground="White" FontSize="16" DockPanel.Dock="Left" VerticalAlignment="Center" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                    <!-- TỰ ĐỘNG LOAD ITEM TẠI ĐÂY -->
                    <ItemsControl ItemsSource="{Binding MenuItems}" Margin="8,8,8,12">
                        <ItemsControl.Resources>
                            <!-- Style Gốc của bạn - Không đổi một thông số nào -->
                            <Style x:Key="SidebarMenuButtonBase" TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Height" Value="40" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter VerticalAlignment="Center" Margin="12,0" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333337" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#2B2B2E" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Resources>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Mỗi Button được sinh ra tương ứng với 1 Plugin trong MenuItems -->
                                <Button Content="{Binding Name}" 
                                        Margin="8,4" 
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SidebarMenuButtonBase}">
                                            <Style.Triggers>
                                                <!-- Bind vào IsSelected của PluginMetadata -->
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#27272A" />
                                                    <Setter Property="Foreground" Value="White" />
                                                    <Setter Property="BorderThickness" Value="4,0,0,0" />
                                                    <Setter Property="BorderBrush" Value="#0078D7" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>